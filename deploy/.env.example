# Copy to /opt/cyberdudebivash-api/.env on the VPS (chmod 600, owned by the
# cyberdudebivash service user). This is loaded by systemd's EnvironmentFile.
#
# The backend as currently written (cyberdudebivash_army_backend.py) does not
# require any secret to run — it has no database and no authentication (see
# docs/commercial/COMMERCIAL_PRODUCTION_GAP_REGISTER.md, GAP-003). This file
# exists mainly as a documented place to add real config once that changes,
# not because anything below is required today.

# Unused by deploy/systemd/cyberdudebivash-api.service (which passes --port
# 8000 directly on the command line), but kept here in case you switch back
# to `python cyberdudebivash_army_backend.py` for local/manual runs — that
# entry point does read PORT from the environment.
PORT=8000

# Not yet read by any code in this repo. If you add authentication to
# POST /api/v1/ingest (strongly recommended before relying on this backend
# for anything customer-facing — see GAP-003), wire it to check this value
# and update deploy/seed_kev_feed.py to send it as a header.
# INGEST_SECRET=
